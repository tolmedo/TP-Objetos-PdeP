import PepitosSweetRescue.*
import pepito.*


describe "Pruebas de la primer parte" {

  test "La cantidad de puntos cumple con la condicion de ganar" {
    juegoPepitosSweetRescue.ganar()
    assert.equals(6000,juegoPepitosSweetRescue.puntos)
  }

  test "La cantidad de vidas cumple con la condicion de perder" {
    juegoPepitosSweetRescue.perder()
    assert.equals(0,pepito.vidas)
  }

  /*
