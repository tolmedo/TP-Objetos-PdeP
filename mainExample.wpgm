import wollok.game.*

import pepito.*
import vasoDeLeche.*

program pepitaGame {
	game.title("Pepito´s Sweet Rescue")
	game.height(10)
	game.width(10)
	
	// add assets in asset folder, for example, for the background
    game.boardGround("cocina.png")
	game.addVisual(vasoDeLeche)
	game.addVisualCharacter(pepito)

	//

	game.showAttributes(pepito) //Debug

	game.start()
}
